# =============================================================================
# Mall för miljövariabler — KOPIERA till en fil som heter ".env"
# =============================================================================
# 1. Kör i terminalen: cp .env.example .env
# 2. Fyll i dina riktiga nycklar i .env
# 3. .env ligger i .gitignore och pushas ALDRIG till GitHub
# =============================================================================

# OpenAI API-nyckel (skapas på https://platform.openai.com/api-keys)
OPENAI_API_KEY=sk-proj-din-nyckel-har

# Anthropic API-nyckel (skapas på https://console.anthropic.com/settings/keys)
# Lämna tom om du inte använder Claude-modeller
ANTHROPIC_API_KEY=sk-ant-din-nyckel-har

# Ollama-server (default-adress, ändra bara om du kör Ollama på annan port/host)
OLLAMA_BASE_URL=http://localhost:11434

# Vald LLM-leverantör vid uppstart: "openai", "anthropic" eller "ollama"
LLM_PROVIDER=openai

# Vald modell per leverantör (kan ändras i Streamlit-appen)
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_MODEL=claude-haiku-4-5
OLLAMA_MODEL=llama3.1:8b
